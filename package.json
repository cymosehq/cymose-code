{
	"name": "cymose-code",
	"version": "0.1.3",
	"description": "Local Cymose session graph for coding harnesses. The host runs inference; the graph stays in process.",
	"license": "Apache-2.0",
	"type": "module",
	"main": "lib/src/index.js",
	"types": "lib/src/index.d.ts",
	"exports": {
		".": {
			"types": "./lib/src/index.d.ts",
			"default": "./lib/src/index.js"
		},
		"./dsh": {
			"types": "./lib/dsh/index.d.ts",
			"default": "./lib/dsh/index.js"
		},
		"./mcp": {
			"types": "./lib/mcp/index.d.ts",
			"default": "./lib/mcp/index.js"
		},
		"./dsh/cordis.patch.yml": "./dsh/cordis.patch.yml",
		"./package.json": "./package.json"
	},
	"files": [
		"lib/src",
		"lib/dsh",
		"lib/mcp",
		"dsh/cordis.patch.yml",
		"LICENSE",
		"NOTICE"
	],
	"bin": {
		"cymose-mcp": "lib/mcp/stdio.js"
	},
	"engines": {
		"node": ">=20"
	},
	"dsh": {
		"bundle": {
			"patch": "./dsh/cordis.patch.yml"
		},
		"compatibility": {
			"dsh": ">=0.1.0-rc.8 <0.2.0",
			"dshReleases": {
				"0.1.2-alpha.2": "unknown",
				"0.1.2-alpha.3": "unknown",
				"0.1.2-alpha.4": "unknown"
			},
			"profiles": [
				"web",
				"headless"
			]
		}
	},
	"scripts": {
		"build": "rm -rf lib && tsc",
		"test": "vitest run",
		"typecheck": "tsc --noEmit"
	},
	"keywords": [
		"cymose",
		"deepseek-harness",
		"dsh",
		"dsh-plugin",
		"cordis",
		"mcp"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/cymosehq/cymose-code"
	},
	"peerDependencies": {
		"@deepseek-ai/cordis": "^4.0.1",
		"@deepseek-ai/dsh-tools": "^0.1.0-rc.6"
	},
	"devDependencies": {
		"@deepseek-ai/cordis": "^4.0.1",
		"@deepseek-ai/dsh-tools": "^0.1.0-rc.6",
		"@types/node": "^22.15.0",
		"typescript": "^5.8.0",
		"vitest": "^3.2.0"
	}
}
