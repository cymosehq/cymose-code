{
	"compilerOptions": {
		"target": "ES2022",
		"module": "Node16",
		"moduleResolution": "Node16",
		"outDir": "lib",
		"rootDir": ".",
		"declaration": true,
		"strict": true,
		"skipLibCheck": true,
		"esModuleInterop": true
	},
	"include": ["src/**/*.ts", "dsh/**/*.ts", "mcp/**/*.ts"],
	"exclude": ["src/**/*.test.ts"]
}
